# À créer dans Vercel > Project Settings > Environment Variables (ou dans votre fichier .env local)
# Ne jamais enregistrer les vraies valeurs dans Git.

# Formulaire de contact (Web3Forms)
VITE_WEB3FORMS_ACCESS_KEY=replace_with_your_web3forms_access_key
WEB3FORMS_ACCESS_KEY=replace_with_your_web3forms_access_key

# Google Places API (New) — Utilisé côté serveur uniquement (api/google-reviews.js)
# NE PAS ajouter de préfixe VITE_ à ces variables privées.
GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=
